{
  "name": "jcode-vscode",
  "displayName": "Jcode",
  "description": "Chat with Jcode in the VS Code sidebar and send the active editor selection as context.",
  "version": "0.5.0",
  "publisher": "jcode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinclaudio/jcode-vscode.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "jcode",
    "ai",
    "agent",
    "coding"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jcode.open",
        "title": "Jcode: Open Chat"
      },
      {
        "command": "jcode.openTerminal",
        "title": "Jcode: Open Terminal Agent"
      },
      {
        "command": "jcode.askSelection",
        "title": "Jcode: Ask About Selection"
      },
      {
        "command": "jcode.explainSelection",
        "title": "Jcode: Explain Selection"
      },
      {
        "command": "jcode.fixSelection",
        "title": "Jcode: Fix Selection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jcode",
          "title": "Jcode",
          "icon": "media/jcode.svg"
        }
      ]
    },
    "views": {
      "jcode": [
        {
          "type": "webview",
          "id": "jcode.chatView",
          "name": "Chat",
          "icon": "media/jcode.svg",
          "contextualTitle": "Jcode Chat"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "jcode.askSelection",
          "group": "jcode@1",
          "when": "editorHasSelection"
        },
        {
          "command": "jcode.explainSelection",
          "group": "jcode@2",
          "when": "editorHasSelection"
        },
        {
          "command": "jcode.fixSelection",
          "group": "jcode@3",
          "when": "editorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "jcode.open"
        },
        {
          "command": "jcode.openTerminal"
        },
        {
          "command": "jcode.askSelection"
        },
        {
          "command": "jcode.explainSelection"
        },
        {
          "command": "jcode.fixSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "jcode.askSelection",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Jcode",
      "properties": {
        "jcode.executablePath": {
          "type": "string",
          "default": "jcode",
          "description": "Path to the Jcode executable."
        },
        "jcode.launchArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra global arguments passed to Jcode chat runs and the interactive terminal."
        },
        "jcode.maxSelectionCharacters": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "description": "Maximum number of selected characters that may be sent to Jcode."
        },
        "jcode.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default model applied to new Jcode chat sessions and the terminal agent, e.g. `deepseek-v4-pro`. When empty, Jcode's own default model is used. The sidebar chat has its own model picker that overrides this."
        },
        "jcode.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Fallback model names for the sidebar chat model picker when Jcode's live model catalog is unreachable. When empty, a built-in curated list is used. The picker normally lists the real catalog from the connected Jcode daemon (`listModels`)."
        },
        "jcode.defaultEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "",
          "markdownDescription": "Default reasoning effort applied to new Jcode chat sessions (`setReasoningEffort`) and passed to the terminal agent via the `JCODE_OPENAI_REASONING_EFFORT` / `JCODE_ANTHROPIC_REASONING_EFFORT` environment variables. When empty, Jcode's own default is used. Levels: `none`, `minimal`, `low`, `medium`, `high`, `xhigh`, `max`; the accepted set depends on the provider."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js",
    "test:acceptance": "node scripts/run-acceptance.js",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "@1jehuang/jcode-sdk": "^1.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
